## APPENDIX A: Sample Code Snippets

### A.1: Real-time Booking Query (useBookings.ts)
```typescript
const q = query(
  collection(db, "bookings"),
  where("studioId", "==", studioId),
  orderBy("eventDate", "desc")
);

const unsubscribe = onSnapshot(q, (snapshot) => {
  const bookings = snapshot.docs.map(doc => ({
    id: doc.id,
    ...doc.data()
  })) as Booking[];
  setBookings(bookings.filter(b => b.status !== 'deleted'));
});
```

### A.2: Cloudinary Image Upload (cloudinary.ts)
```typescript
export const uploadImageToCloudinary = async (file: File) => {
  const formData = new FormData();
  formData.append("file", file);
  formData.append("upload_preset", "cameraman_gallery");
  
  const response = await fetch(
    `https://api.cloudinary.com/v1_1/dh3adqhdd/image/upload`,
    { method: "POST", body: formData }
  );
  
  return await response.json(); // { secure_url, public_id }
};
```

### A.3: BĀBU AI Call (groq.ts)
```typescript
export async function sendMessageToBabu(userMessage: string, contextInfo?: string) {
  const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${import.meta.env.VITE_GROQ_API_KEY}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: "llama-3.3-70b-versatile",
      messages: [
        { role: "system", content: BABU_SYSTEM_PROMPT + contextInfo },
        { role: "user", content: userMessage }
      ],
      temperature: 0.2,
      max_tokens: 900
    })
  });
  return (await response.json()).choices[0].message.content;
}
```

### A.4: New User Registration (AuthContext.tsx)
```typescript
if (!userSnap.exists()) {
  const newStudioId = generateStudioCode(); // e.g. "AB3K7Z"
  
  // Create studio document
  await setDoc(doc(db, "studios", newStudioId), {
    name: `${user.displayName}'s Studio`,
    ownerId: user.uid,
    createdAt: serverTimestamp(),
    settings: { currency: 'INR' }
  });
  
  // Create user profile
  await setDoc(doc(db, "users", user.uid), {
    uid: user.uid,
    name: user.displayName,
    email: user.email,
    studioId: newStudioId,
    role: 'admin',
    createdAt: serverTimestamp()
  });
}
```

