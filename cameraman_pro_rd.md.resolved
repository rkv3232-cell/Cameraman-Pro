### B.3: Firestore Document Create (SDK, not HTTP)
```typescript
// Write
const docRef = await addDoc(collection(db, "bookings"), {
  studioId: "AB3K7Z",
  clientName: "Ram Sharma",
  financials: { totalAmount: 5000000, advancePaid: 1500000, balanceDue: 3500000 },
  status: "pending",
  createdAt: serverTimestamp()
});

// Response: docRef.id = "7XkqMnP2ABCdef"

// Real-time Read
onSnapshot(q, (snapshot) => {
  snapshot.docChanges().forEach(change => {
    if (change.type === 'added') console.log('New booking:', change.doc.data());
    if (change.type === 'modified') console.log('Updated:', change.doc.data());
    if (change.type === 'removed') console.log('Deleted:', change.doc.id);
  });
});
```

