## 6. DATABASE DESIGN

### 6.1 Collections Overview

Firestore is a **NoSQL document database**. Think of collections as tables, documents as rows.

```
Firestore Root
├── users/           → One doc per logged-in user
├── studios/         → One doc per studio
├── bookings/        → All bookings (filtered by studioId)
├── inventory/       → Equipment items (filtered by studioId)
├── expenses/        → Expense records (filtered by studioId)
├── enquiries/       → Leads from public form
├── gallery/         → Gallery image metadata (Cloudinary references)
└── trash/           → Soft-deleted items (expire in 30 days)
```

### 6.2 Collection Schemas

#### `users/{uid}`
```typescript
{
  uid: string;           // Firebase Auth UID
  name: string;          // "Chandan Kumar Verma"
  email: string;         // "chandan@studio.com"
  phone?: string;
  photoURL?: string;     // Google profile picture URL
  studioId: string;      // "AB3K7Z" — links user to their studio
  role: 'admin' | 'photographer' | 'assistant';
  createdAt: Timestamp;
}
```

#### `studios/{studioId}`
```typescript
{
  name: string;          // "Chandan's Studio"
  ownerId: string;       // Firebase Auth UID
  studioCode: string;    // "AB3K7Z" — 6-char team invite code
  createdAt: Timestamp;
  settings: {
    currency: 'INR';
    businessHours: { start: '09:00', end: '18:00' }
  }
}
```

#### `bookings/{bookingId}`
```typescript
{
  studioId: string;
  clientName: string;
  clientPhone: string;
  clientEmail?: string;
  clientAddress?: string;
  eventType: 'wedding' | 'pre-wedding' | 'birthday' | 'corporate' | 'other';
  eventDate: Timestamp;          // Primary date (for backward compat)
  venue: string;
  subEvents: [{                  // Multi-day event support
    id: string;
    title: string;               // "Haldi", "Baraat", "Reception"
    date: string;                // "2026-06-15"
    time: string;                // "10:00 AM"
  }];
  equipmentBooked: [{
    itemId: string;
    name: string;
    qty: number;
    rentalRate: number;          // paise
  }];
  financials: {
    totalAmount: number;         // paise (₹50,000 = 5000000)
    advancePaid: number;
    balanceDue: number;
    paymentHistory: [{
      id: string;
      amount: number;
      method: 'cash' | 'upi' | 'bank_transfer' | 'cheque';
      date: Timestamp;
      referenceId?: string;
    }]
  };
  postProductionStatus: {
    dataBackup: boolean;
    photoEditing: boolean;
    videoMixing: boolean;
    albumSent: boolean;
    progress: number;            // 0-100
    completedAt?: string;
  };
  teamAssignment: {
    mainPhotographer?: { uid, name, role };
    droneOperator?: { uid, name, role };
    editor?: { uid, name, role };
    assistants: [{ uid, name, role }];
  };
  clientPortal: {
    status: 'inactive' | 'active' | 'selections_submitted' | 'album_ready';
    pin?: string;
    galleryLink?: string;
    paymentLink?: string;
    selectionImages?: [{ id, url, isSelected }];
  };
  contracts: [{
    name: string;
    url: string;
    storagePath: string;
    type: 'pdf' | 'image';
    uploadedAt: string;
    sizeKb: number;
  }];
  shootTimeline: [{
    id: string;
    time: string;
    label: string;
    notes?: string;
    order: number;
  }];
  status: 'pending' | 'confirmed' | 'completed' | 'cancelled' | 'deleted';
  notes?: string;
  createdAt: Timestamp;
  updatedAt: Timestamp;
  createdBy: string;             // uid
  createdByName: string;
}
```

#### `inventory/{itemId}`
```typescript
{
  studioId: string;
  name: string;                  // "Sony A7III"
  category: 'camera' | 'lens' | 'lighting' | 'tripod' | 'accessory' | 'drone';
  status: 'available' | 'booked' | 'maintenance' | 'in_service' | 'damaged' | 'deleted';
  serialNumber?: string;
  purchaseDate?: Timestamp;
  condition: 'new' | 'good' | 'fair' | 'poor';
  dailyRentalRate: number;       // paise
  notes?: string;
  currentBookingId?: string;
}
```

#### `expenses/{expenseId}`
```typescript
{
  studioId: string;
  amount: number;                // paise
  category: 'fuel' | 'assistant_payment' | 'repair_maintenance' | 'miscellaneous';
  date: Timestamp;
  linkedBookingId?: string;
  linkedBookingName?: string;
  notes?: string;
  createdBy: string;
  createdByName: string;
  createdAt: Timestamp;
}
```

#### `enquiries/{enquiryId}`
```typescript
{
  studioId?: string;             // May be null for public submissions
  name: string;
  phone: string;
  email?: string;
  eventType: string;             // "Wedding", "Pre-wedding"
  date: string;                  // "2026-12-20"
  location: string;
  message: string;
  source?: string;               // "Instagram", "Google"
  status: 'new' | 'contacted' | 'converted' | 'closed';
  createdAt: Timestamp;
}
```

### 6.3 ER Diagram (Text Format)

```
USERS ──────────── STUDIOS
  │ uid (PK)           │ studioId (PK, = Studio Code)
  │ studioId (FK) ─────┘ name
  │ role                  ownerId (FK → USERS)
  │
  │
BOOKINGS ──────── INVENTORY
  │ bookingId (PK)     │ itemId (PK)
  │ studioId (FK) ────┤  studioId (FK)
  │ clientName         │  name
  │ financials{}        │  category
  │ subEvents[]         │  dailyRentalRate
  │ equipmentBooked[] ──┘ (matches itemId)
  │ teamAssignment{}
  │ clientPortal{}
  │ postProductionStatus{}
  │
  │
EXPENSES ────────── ENQUIRIES
  │ expenseId (PK)     │ enquiryId (PK)
  │ studioId (FK)      │ studioId? (FK, optional)
  │ amount              │ name, phone, eventType
  │ linkedBookingId─── │ status
      (FK → BOOKINGS)

TRASH (temporary, expires in 30 days)
  trashId (PK)
  originalCollection → 'bookings' | 'equipment'
  originalId (FK → original doc)
  studioId (FK)
  expiresAt: Timestamp
```

